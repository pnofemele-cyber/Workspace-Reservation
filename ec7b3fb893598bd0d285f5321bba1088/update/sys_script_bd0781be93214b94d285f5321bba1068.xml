        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var wsGR = new GlideRecord('x_787189_wrm_workspace_options');
    if (wsGR.get(current.workspace)) {

        var mainStatus = current.getValue('ticket_status');
        var mainWorkspaceStatus = current.getValue('workspace_status');

        if (mainStatus == 'open' && mainWorkspaceStatus == 'in_maintenance') {
            wsGR.status = 'unavailable';
		} else if (mainStatus == 'closed' && mainWorkspaceStatus == 'available') {
			wsGR.status = 'available';
		} else if (mainStatus == 'closed' && mainWorkspaceStatus == 'decommissioned') {
            wsGR.status = 'decommissioned';
        } else if (mainStatus == 'closed' && mainWorkspaceStatus == 'available') {
            wsGR.status = 'available';
        }
        wsGR.update();
    }
})(current, previous);]]></script>
