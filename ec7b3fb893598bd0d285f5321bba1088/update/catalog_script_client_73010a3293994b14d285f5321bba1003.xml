    var start = g_form.getValue('start_date_time');
    var end = g_form.getValue('end_date_time');

    //Comparison for start and end date
    if (end < start) {
        g_form.showFieldMsg('end_date_time', 'End date/time should not be before the Start date/time', 'error');
